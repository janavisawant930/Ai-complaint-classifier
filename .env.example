# ==========================================
# Frontend Environment Variables (Vite)
# ==========================================
# In local development, defaults to http://127.0.0.1:5000/api
# In production deployment, set to your live backend API URL
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# ==========================================
# Backend Environment Variables (Flask)
# ==========================================
PORT=5000
FLASK_ENV=production
SECRET_KEY=your_production_secret_key_here

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# MySQL Database Settings (Option A: Separate variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=complaint_db

# MySQL Database Settings (Option B: Single Cloud URL connection string - optional)
# DATABASE_URL=mysql://user:password@host:port/dbname

# CORS Allowed Origins (* for all, or comma-separated origins e.g. https://your-frontend.vercel.app)
CORS_ORIGINS=*
